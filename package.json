{
  "name": "@ccpilot/workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Chas Callenge 2026 Project Group 4",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "turbo build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:clean": "docker compose down && rm -rf ./pgdata",
    "db:shell": "sh -c 'command -v docker >/dev/null && docker exec -it ccpilot_db psql -U ccpilot_admin ccpilot_db || podman exec -it ccpilot_db psql -U ccpilot_admin ccpilot_db'",
    "docs:ship": "pnpm --filter docs ship",
    "docs:update": "node ./scripts/sync-docs.mjs",
    "prompts:gen": "node ./scripts/generate-prompts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "latest",
    "tslib": "^2.8.1",
    "turbo": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "overrides": {
      "typescript": "^6.0.0",
      "eslint": "^10.0.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "typescript",
        "eslint"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "netlify-cli",
      "sharp",
      "unix-dgram"
    ]
  }
}
