{
  "name": "@ccpilot/workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Chas Callenge 2026 Project Group 4",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "turbo build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:up": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:clean": "docker compose down && rm -rf ./pgdata",
    "docs:ship": "pnpm --filter docs ship"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "latest",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "latest",
    "tslib": "^2.8.1",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.57.2"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "typescript": "^6.0.0",
      "eslint": "^10.0.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "typescript",
        "eslint"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "netlify-cli",
      "sharp",
      "unix-dgram"
    ]
  }
}
